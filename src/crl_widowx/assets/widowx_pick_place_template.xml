<mujoco model="widowx_pick_place">
  <compiler angle="radian" autolimits="true" meshdir="{{MESH_DIR}}" texturedir="{{TEXTURE_DIR}}" />
  <include file="{{ROBOT_XML_PATH}}" />

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" />

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.25 0.25 0.25" specular="0.2 0.2 0.2" />
    <rgba haze="0.12 0.18 0.25 1" />
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.16 0.18 0.20" rgb2="0.23 0.25 0.28" width="512" height="512" />
    <material name="ground_mat" texture="grid" texrepeat="6 6" reflectance="0.15" />
    <material name="red_zone_mat" rgba="0.85 0.2 0.2 0.8" />
    <material name="blue_zone_mat" rgba="0.2 0.35 0.9 0.8" />
    <material name="cube_mat" rgba="0.2 0.85 0.25 1" />
    <material name="table_mat" rgba="0.44 0.33 0.21 1" />
  </asset>

  <worldbody>
    <light pos="0 0 1.2" dir="0 0 -1" directional="true" />

    <geom name="ground" type="plane" size="1.5 1.5 0.05" material="ground_mat" />

    <camera name="isometric" pos="0.62 -0.34 0.58"
      xyaxes="0.667 0.745 0.000 -0.522 0.467 0.714" fovy="42" />
    <camera name="topdown" pos="0.24 0.0 0.95" xyaxes="1 0 0 0 1 0" fovy="32" />

    <body name="table" pos="0.24 0 0.02">
      <geom name="table_top" type="box" size="0.20 0.20 0.02" material="table_mat" friction="1.0 0.005 0.0001" />
    </body>

    <site name="red_zone_site" type="box" pos="0.24 -0.10 0.041" size="0.04 0.04 0.001" material="red_zone_mat" />
    <site name="blue_zone_site" type="box" pos="0.24 0.10 0.041" size="0.04 0.04 0.001" material="blue_zone_mat" />

    <body name="cube" pos="0.24 -0.10 0.06">
      <freejoint name="cube_freejoint" />
      <geom name="cube_geom" type="box" size="0.018 0.018 0.018" mass="0.06" material="cube_mat"
        friction="0.95 0.01 0.0005" condim="4" />
    </body>
  </worldbody>
</mujoco>
